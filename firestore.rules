rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'sachink15780@gmail.com';
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.paymentMethod in ['UPI', 'COD'];

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 600
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 2;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

  }
}